# Copy to .env in the implementation repo. Never commit .env.
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://pcbbrain:pcbbrain@localhost:5432/pcbbrain
DATA_DIR=/data/pcb-brain          # raw/, parsed/, index/
KICAD_CLI=/usr/bin/kicad-cli
KICAD_IPC_SOCKET=                 # leave empty for default
KICAD_IPC_TOKEN=
FREEROUTING_JAR=/opt/freerouting/freerouting.jar
NGSPICE_BIN=/usr/bin/ngspice

DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
MOUSER_API_KEY=
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
ELEMENT14_API_KEY=
TME_TOKEN=
TME_SECRET=

EMBEDDING_PROVIDER=voyage         # voyage | local
VOYAGE_API_KEY=
LOCAL_EMBED_MODEL=BAAI/bge-m3

MONTHLY_API_BUDGET_USD=250
